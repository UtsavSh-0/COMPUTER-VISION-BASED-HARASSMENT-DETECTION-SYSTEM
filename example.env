# --- Backend Configuration ---
# Set to 'true' if you have an NVIDIA GPU and want to use CUDA
USE_GPU=false

# --- Frontend Configuration ---
# The URL where the FastAPI backend is running
API_URL=http://localhost:8000/predict

# WebRTC / Twilio Configuration (Optional)
# Required for the live webcam feed to work over certain network configurations (STUN/TURN)
# Get these from your Twilio Console (https://www.twilio.com/console)
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
